<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="collective.z3cform.jsonwidget"
    >

  <!-- Test-only views, loaded exclusively by CollectiveZ3CformJsonwidgetLayer -->

  <browser:page
      name="test-jsonwidget-form"
      for="*"
      class=".views.JSONWidgetTestView"
      permission="zope2.View"
      />

</configure>
